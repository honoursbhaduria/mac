# Copy to .env to override defaults. No Elexon API key is required.

# --- backend ---
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
MAX_DATE_RANGE_DAYS=93
# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=INFO
GROQ_API_KEY=your_groq_api_key_here

# --- docker compose host ports ---
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- frontend (build time) ---
# Leave empty to call the API on the same origin (/api). Set to the API origin for split hosting.
VITE_API_BASE_URL=
