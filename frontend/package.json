    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
